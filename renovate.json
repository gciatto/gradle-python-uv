{
   "$schema": "https://docs.renovatebot.com/renovate-schema.json",
   "extends": [
      "github>DanySK/renovate-config:gradle-plugin"
   ],
   "customManagers": [
      {
         "customType": "regex",
         "description": "Default versions of the Python tools in the plugin conventions",
         "managerFilePatterns": [
            "/^src/main/kotlin/.+/Conventions\\.kt$/"
         ],
         "matchStrings": [
            "\"(?<depName>[A-Za-z0-9_.-]+)>=(?<currentValue>\\d[^\",<]*)\""
         ],
         "datasourceTemplate": "pypi"
      },
      {
         "customType": "regex",
         "description": "uv version downloaded by the plugin when uv is not installed",
         "managerFilePatterns": [
            "/^src/main/kotlin/.+/Conventions\\.kt$/"
         ],
         "matchStrings": [
            "const val DEFAULT_UV_VERSION = \"(?<currentValue>[^\"]+)\""
         ],
         "depNameTemplate": "uv",
         "datasourceTemplate": "pypi"
      }
   ],
   "packageRules": [
      {
         "description": "Keep the default tools compatible with Python 3.10; coverage 7.17 requires Python 3.11",
         "matchPackageNames": ["coverage"],
         "allowedVersions": "<7.17.0"
      },
      {
         "description": "Keep tests compatible with Java 17; ClassGraph 6 requires Java 25",
         "matchPackageNames": ["io.github.classgraph:classgraph"],
         "allowedVersions": "<6.0.0"
      },
      {
         "description": "Python dependencies of test fixtures are pinned on purpose",
         "matchFileNames": [
            "src/test/resources/**"
         ],
         "matchManagers": [
            "pep621"
         ],
         "enabled": false
      }
   ]
}
